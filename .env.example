# ==============================================================================
# SAYRA Central Backend - Local Development Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your local values.
# Real credentials, private keys, passwords, or production secrets MUST NEVER
# be committed to source control.
# ==============================================================================

# PostgreSQL Connection Settings and Credentials
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sayra_db_dev
DB_USER=your_local_postgres_username
DB_PASSWORD=your_local_postgres_password

# PostgreSQL Connection String (Authoritative source for standard .NET configuration)
Database__ConnectionString="Host=127.0.0.1;Port=5432;Database=sayra_db_dev;Username=your_local_postgres_username;Password=your_local_postgres_password"

# Redis Connection Settings and Credentials
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
Redis__ConnectionString="127.0.0.1:6379"

# Sayra Master/Token Cryptographic Security Keys
# Must be at least 32 bytes for HMAC-SHA256
SAYRA_MASTER_KEY=YOUR_DEVELOPMENT_SAYRA_MASTER_KEY_PLACEHOLDER_32_BYTES_MIN
Security__TokenSigningKey=YOUR_DEVELOPMENT_SAYRA_MASTER_KEY_PLACEHOLDER_32_BYTES_MIN

# Cryptographic Keys (PEM format or paths)
Security__PrivateKeyPem="YOUR_RSA_PRIVATE_KEY_PEM_PLACEHOLDER"
Security__PublicKeyPem="YOUR_RSA_PUBLIC_KEY_PEM_PLACEHOLDER"
Updates__UpdatePublicKeyPem="YOUR_RSA_UPDATE_PUBLIC_KEY_PEM_PLACEHOLDER"

# TLS Configuration
Tls__RequireClientCertificate=false
Tls__CertificatePath="path/to/certificate.pfx"
Tls__CertificatePassword="YOUR_PFX_PASSWORD_PLACEHOLDER"

# Server / API / Transport Configuration
Server__Port=5000
Server__Host="*"
Discovery__UdpPort=37020
Discovery__ServerName="SayraServer"
